{
  "name": "nextjs-tools",
  "version": "0.1.28",
  "scripts": {
    "dev": "source .env && PORT=$PORT NODE_OPTIONS='--inspect --enable-source-maps=true' next dev --turbopack",
    "export": "sh ./script/build.sh",
    "tag": "sh ./script/tag.sh $(jq \".version\" package.json | tr -d '\"')"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3v-friends/nextjs-tools"
  },
  "dependencies": {
    "pbkdf2": "3.1.2"
  },
  "devDependencies": {
    "@types/pbkdf2": "3.1.2",
    "next": "15.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/node": "22.14.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  }
}
