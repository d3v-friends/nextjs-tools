{
  "name": "nextjs-tools",
  "version": "0.1.0",
  "scripts": {
    "dev": "source .env && PORT=$PORT NODE_OPTIONS='--inspect --enable-source-maps=true' next dev --turbopack",
    "build": "rm -rf ./dist && tsc -p tsconfig.export.json && git add dist"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3v-friends/nextjs-tools"
  },
  "dependencies": {
    "next": "15.2.1",
    "pbkdf2": "3.1.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/pbkdf2": "3.1.2",
    "@tailwindcss/postcss": "4.0.12",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "prettier": "3.5.3",
    "sass": "1.85.1",
    "tailwindcss": "4.0.12",
    "typescript": "5.8.2"
  }
}
