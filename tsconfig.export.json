{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "baseUrl": ".",
    "outDir": "./dist",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "declaration": true,
    "inlineSourceMap": true,
    "removeComments": true,
    "paths": {
      "@comp/*": [
        "./src/comp/*"
      ],
      "@comp": [
        "./src/comp"
      ],
      "@func/*": [
        "./src/func/*"
      ],
      "@func": [
        "./src/func"
      ],
      "@type": [
        "./src/type"
      ],
      "@type/*": [
        "./src/type/*"
      ]
    }
  },
  "include": [
    "./src/func/index.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
